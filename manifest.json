{
  "manifest_version": 3,
  "name": "bilifeed2later",
  "version": "0.3.0",
  "description": "B站关注动态自动加入稍后再看（复用浏览器登录态，零构建）",
  "permissions": ["alarms", "storage", "cookies"],
  "host_permissions": ["https://*.bilibili.com/*"],
  "optional_host_permissions": [
    "https://open.feishu.cn/*",
    "https://api.telegram.org/*",
    "https://api.day.app/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "bilifeed2later",
    "default_popup": "action_popup.html"
  }
}
